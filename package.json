{
  "name": "mathstudio",
  "version": "0.1.0",
  "description": "MathStudio: math equations (and later geometry) for Microsoft Word",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "dev": "npm run assets && vite",
    "dev:https": "npm run assets && cross-env HTTPS=1 vite",
    "build": "npm run assets && tsc && vite build",
    "build:offline": "npm run assets && tsc && vite build --mode offline",
    "preview": "vite preview",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "validate": "office-addin-manifest validate manifest.xml",
    "start": "office-addin-debugging start manifest.xml desktop --app word --no-debug",
    "stop": "office-addin-debugging stop manifest.xml",
    "dev-server": "npm run assets && cross-env HTTPS=1 vite",
    "hotkeys": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/hotkeys-win/build.ps1 && start \"\" dist-tools/MathStudioHotkeys.exe"
  },
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@mathjax/mathjax-newcm-font": "^4.1.3",
    "@mathjax/mathjax-stix2-font": "^4.1.3",
    "@mathjax/mathjax-termes-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "cfb": "^1.2.2",
    "fflate": "^0.8.3",
    "mathlive": "^0.111.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "temml": "^0.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/office-js": "^1.0.612",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "office-addin-debugging": "^7.0.1",
    "office-addin-dev-certs": "^3.0.1",
    "office-addin-manifest": "^3.0.1",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "private": true,
  "config": {
    "dev_server_port": 3000
  }
}
